{
  "name": "pr-pilot",
  "version": "1.0.0",
  "description": "AI-powered GitHub PR reviewer supporting OpenAI, Anthropic, and Gemini",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "bundle": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/ __tests__/",
    "lint:fix": "eslint src/ __tests__/ --fix",
    "format": "prettier --write 'src/**/*.ts' '__tests__/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts' '__tests__/**/*.ts'",
    "all": "npm run lint && npm run format:check && npm run test && npm run bundle"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Anyrouter232/pr-pilot.git"
  },
  "keywords": [
    "github-action",
    "code-review",
    "openai",
    "anthropic",
    "gemini",
    "pull-request",
    "ai"
  ],
  "author": "Anyrouter232",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0",
    "@anthropic-ai/sdk": "^0.30.0",
    "@google/generative-ai": "^0.21.0",
    "js-yaml": "^4.1.0",
    "minimatch": "^9.0.3",
    "openai": "^4.73.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.3.3"
  }
}
